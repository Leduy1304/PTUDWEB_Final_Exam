# Copy this file to .env and fill in your values.
PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/taskmanager
# ...or a MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager
# Long random string used to sign JWTs:
JWT_SECRET=change-me-to-a-long-random-string
# Optional: the account that registers with this email is granted the "admin"
# role automatically (bootstrap for a fresh deployment). Leave unset to rely
# on startup auto-promotion of the earliest user instead.
# ADMIN_EMAIL=you@example.com
